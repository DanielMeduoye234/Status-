# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# AI Provider API Keys (Supports Google Gemini or OpenAI)
GEMINI_API_KEY=your-google-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Recall.ai Meeting Notetaker Bot Integration
# Get your API key from https://www.recall.ai
# Supported regions: us-west-2, us-east-1, eu-central-1, ap-northeast-1
RECALL_AI_API_KEY=your-recall-ai-api-key
RECALL_AI_REGION=us-west-2

